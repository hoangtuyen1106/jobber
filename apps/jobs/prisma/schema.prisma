generator client {
  provider = "prisma-client"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Job {
    id Int @default(autoincrement()) @id
    name String
    size Int
    completed Int
    status String
    started DateTime @default(now())
    ended DateTime?
}